# ───────── Proveedores de IA (al menos uno es obligatorio) ─────────
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cuál responde primero: gemini | groq
PRIMARY_PROVIDER=gemini
# fallback = pregunta al principal y, si falla, al otro (recomendado, más barato)
# race     = pregunta a los dos a la vez y usa la primera respuesta válida (más rápido, cuesta doble)
CHAT_STRATEGY=fallback

# Tiempo máximo por proveedor (ms) y tokens máximos de respuesta
PROVIDER_TIMEOUT_MS=25000
MAX_OUTPUT_TOKENS=4096

# ───────── Datos de lugares (backend principal de MXGuide) ─────────
MXGUIDE_API_URL=https://mxguide-backend.onrender.com
PLACES_TIMEOUT_MS=15000

# ───────── Seguridad ─────────
# Si lo llenas, la app debe mandar el header  x-api-key: <valor>
CHAT_API_KEY=
# Orígenes permitidos para CORS separados por coma (vacío = todos)
CORS_ORIGINS=
# Peticiones por minuto por IP
RATE_LIMIT_PER_MINUTE=20

PORT=3000
